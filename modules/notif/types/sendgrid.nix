{ lib, notifLib, ... }:
with lib;
with notifLib;
mkConnectorOption {
  implementationName = "SendGrid";
  description = "SendGrid notification definition for Starr services.";
  triggers = mkTriggers {
    sonarr = [ "onRename" ];
    radarr = [ "onRename" ];
    lidarr = [
      "onRename"
      "onTrackRetag"
    ];
  };
  fields = {
    apiKey = secretField "The API key generated by SendGrid.";
    from = field types.str "From address.";
    recipients = field (types.listOf types.str) "Recipient addresses.";
  };
}
