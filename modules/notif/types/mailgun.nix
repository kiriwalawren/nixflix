{ lib, notifLib, ... }:
with lib;
with notifLib;
mkConnectorOption {
  implementationName = "Mailgun";
  description = "Mailgun notification definition for Starr services.";
  perService = {
    sonarr.unsupportedTriggers = [ "onRename" ];
    radarr.unsupportedTriggers = [ "onRename" ];
    lidarr.unsupportedTriggers = [
      "onRename"
      "onDownloadFailure"
      "onImportFailure"
      "onTrackRetag"
    ];
  };
  fields = {
    apiKey = secretField "The API key generated by Mailgun.";
    useEuEndpoint = field types.bool "Use the EU Mailgun endpoint.";
    from = field types.str "From address.";
    senderDomain = field types.str "Sender domain.";
    recipients = field (types.listOf types.str) "Recipient addresses.";
  };
}
